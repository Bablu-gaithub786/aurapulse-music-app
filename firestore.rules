rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: readable by authenticated user or owner, writable by authenticated user for their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Login logs: can be created upon login by authenticated user
    match /login_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Fallback for app data
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
